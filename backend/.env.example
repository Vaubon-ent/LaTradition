PORT=3000
NONCE_SECRET=change-me-to-a-long-random-string
# Compte admin unique partagé (décision M5, .ai/decisions.md) :
# ADMIN_PASSWORD_HASH = hash bcrypt du mot de passe (ex. via bcryptjs.hashSync(password, 10)).
ADMIN_PASSWORD_HASH=change-me-to-a-bcrypt-hash
ADMIN_JWT_SECRET=change-me-to-a-long-random-string
# Origine Netlify autorisée en CORS (M9). Sans cette variable, toute requête
# avec un en-tête Origin est refusée par défaut (décision du 2026-11-07).
ALLOWED_ORIGIN=https://change-me.netlify.app
# Optionnel : délai minimum anti-bot en ms (M3bis). Par défaut 3000 si absent.
# MIN_DELAY_MS=3000
